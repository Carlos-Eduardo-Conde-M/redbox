---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/home/Hero.astro';
import About from '../components/sections/home/About.astro';
import Capabilities from '../components/sections/home/Capabilities.astro';
import Services from '../components/sections/home/Services.astro';
import Certifications from '../components/sections/home/Certifications.astro';
import EmergencyBanner from '../components/sections/home/EmergencyBanner.astro';
import { SITE } from '../config/site';
---

<Layout title={SITE.title} description={SITE.description}>
  <fragment slot="header"><Nav /></fragment>
  <fragment slot="footer"><Footer /></fragment>

  <Hero />
  <About />
  <Capabilities />
  <Services />
  <Certifications />
  <EmergencyBanner />
</Layout>