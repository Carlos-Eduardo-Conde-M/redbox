---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';

const BREADCRUMBS = ['SYSTEM', 'GOVERNANCE', 'LEGAL_DISPATCH_v2.4'];

const COMPANY = [
  { label: 'Entidad Legal', value: 'REDBOX CYBERSECURITY SOLUTIONS S.L.' },
  { label: 'Registro Mercantil', value: 'Tomo 45291, Folio 182, Hoja B-483291, Inscripción 1ª.' },
  { label: 'CIF / VAT ID', value: 'ES-B67890123' },
  { label: 'Sede Central de Operaciones', value: 'Distrito Tecnológico 22@, Barcelona, España.' },
];

const STATUS_ROWS = [
  { key: 'Compliance Level', val: 'ISO 27001', tone: 'primary' },
  { key: 'Last Audit', val: 'OCT-2023', tone: 'neutral' },
  { key: 'Integrity', val: 'ENCRYPTED', tone: 'tertiary' },
];

const RESPONSIBILITIES = [
  'Exclusión de responsabilidad por interrupciones de red externas.',
  'No garantía de infalibilidad absoluta ante ataques de día cero (Zero-Day).',
];
---

<Layout
  title="Aviso Legal"
  description="RedBox Aviso Legal — Identidad de la compañía, jurisdicción, limitación de responsabilidad y canales de contacto legal."
>
  <fragment slot="header"><Nav /></fragment>
  <fragment slot="footer"><Footer /></fragment>

  <main class="pt-32 pb-24 relative min-h-screen">
    <!-- Hero industrial background -->
    <div
      class="absolute inset-0 z-0 opacity-15 pointer-events-none"
      style="background-image: url('/image/futuristic_industrial_circuit_board_background_with_glowing_red_neon_traces.png'); background-attachment: fixed; background-size: cover; background-position: center;"
      aria-hidden="true"
    ></div>
    <div class="absolute top-0 left-0 right-0 h-[2px] z-50 scanline-legal" aria-hidden="true"></div>
    <div class="absolute inset-0 tactical-grid opacity-10 pointer-events-none z-0" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-margin-desktop relative z-10">
      <!-- Breadcrumbs / Status Bar -->
      <nav class="flex items-center gap-sm mb-lg font-mono text-[12px] text-primary opacity-80 scroll-reveal" aria-label="Ruta de navegación">
        <span class="bg-primary/10 px-2 py-0.5 border border-primary/20">{BREADCRUMBS[0]}</span>
        <span class="material-symbols-outlined text-[12px]">chevron_right</span>
        <span class="bg-primary/10 px-2 py-0.5 border border-primary/20">{BREADCRUMBS[1]}</span>
        <span class="material-symbols-outlined text-[12px]">chevron_right</span>
        <span class="text-on-background bg-white/5 px-2 py-0.5">{BREADCRUMBS[2]}</span>
      </nav>

      <!-- Page Title -->
      <header class="mb-xl border-l-4 border-primary pl-lg scroll-reveal">
        <h1 class="font-headline-lg text-display-lg uppercase tracking-tight text-on-background neon-glow">Aviso Legal</h1>
        <p class="font-label-md text-secondary mt-sm uppercase tracking-widest">REDBOX CYBERSECURITY | TACTICAL INDUSTRIAL DEFENSE PROTOCOLS</p>
      </header>

      <!-- Bento Grid Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg">

        <!-- Section 1: Company Identity -->
        <section class="col-span-12 lg:col-span-8 tactical-border p-lg scroll-reveal" aria-labelledby="identity-title">
          <div class="flex items-center justify-between mb-md border-b border-primary/20 pb-sm">
            <h2 id="identity-title" class="font-headline-lg text-headline-lg text-primary flex items-center gap-sm uppercase">
              <span class="material-symbols-outlined">fingerprint</span>
              01. Identidad de la Compañía
            </h2>
            <span class="bg-primary text-white px-sm py-1 font-mono text-[10px] tracking-widest font-bold">VERIFIED</span>
          </div>
          <div class="grid md:grid-cols-2 gap-lg font-body-md text-on-surface">
            {COMPANY.map((row) => (
              <div>
                <p class="text-primary font-label-md text-xs uppercase mb-1 font-bold">{row.label}</p>
                <p class="font-mono text-[12px]">{row.value}</p>
              </div>
            ))}
          </div>
          <div class="mt-lg p-md bg-white/5 border border-primary/10">
            <p class="font-body-md text-on-surface-variant leading-relaxed">
              Este sitio web es operado bajo protocolos estrictos de seguridad industrial. Cualquier acceso no autorizado a los sistemas de administración de esta plataforma será registrado y reportado a las autoridades competentes en materia de ciberdelincuencia.
            </p>
          </div>
        </section>

        <!-- Status Sidebar -->
        <aside class="col-span-12 lg:col-span-4 space-y-md scroll-reveal">
          <div class="p-lg tactical-border">
            <p class="font-label-md text-primary uppercase mb-md flex items-center gap-xs font-bold">
              <span class="material-symbols-outlined text-sm">radar</span> Operational Status
            </p>
            <div class="space-y-sm">
              {STATUS_ROWS.map((row) => (
                <div class="flex justify-between items-center py-2 border-b border-primary/10">
                  <span class="font-mono text-[12px] text-on-surface-variant">{row.key}</span>
                  <span class={`font-bold ${row.tone === 'primary' ? 'text-primary' : row.tone === 'tertiary' ? 'text-tertiary' : 'text-on-background'}`}>{row.val}</span>
                </div>
              ))}
            </div>
            <div class="mt-lg flex gap-xs">
              <div class="w-2 h-2 bg-primary threat-pulse" aria-hidden="true"></div>
              <div class="w-2 h-2 bg-primary opacity-50" aria-hidden="true"></div>
              <div class="w-2 h-2 bg-primary opacity-20" aria-hidden="true"></div>
            </div>
          </div>
          <div class="p-lg tactical-border bg-white/5">
            <p class="font-label-md text-on-surface-variant uppercase mb-sm font-bold">Emergency Response</p>
            <p class="font-body-md mb-md text-sm">Para reportar vulnerabilidades o incidentes legales urgentes:</p>
            <a class="block w-full text-center py-sm border border-primary text-primary font-bold hover:bg-primary hover:text-white transition-all uppercase tracking-widest font-label-md shadow-[0_0_15px_rgba(255,0,0,0.2)] no-underline" href="mailto:security@redbox.cyber">
              INCIDENT REPORT
            </a>
          </div>
        </aside>

        <!-- Section 2: Jurisdictional Compliance -->
        <section class="col-span-12 md:col-span-6 tactical-border p-lg scroll-reveal" aria-labelledby="jurisdiction-title">
          <div class="flex items-center gap-sm mb-md">
            <span class="material-symbols-outlined text-primary">gavel</span>
            <h2 id="jurisdiction-title" class="font-headline-lg text-headline-lg text-on-background uppercase text-xl">02. Jurisdicción</h2>
          </div>
          <div class="space-y-md text-on-surface-variant leading-relaxed">
            <p>Todas las actividades y servicios proporcionados a través de REDBOX se rigen por la legislación española y el marco regulatorio de la Unión Europea (RGPD, NIS2, Directiva CER).</p>
            <p>En caso de litigio, las partes se someten, con renuncia expresa a cualquier otro fuero, a los juzgados y tribunales de la ciudad de Barcelona, salvo que la ley disponga lo contrario por imperativo legal.</p>
          </div>
        </section>

        <!-- Section 3: Liability Disclaimers -->
        <section class="col-span-12 md:col-span-6 tactical-border p-lg scroll-reveal" aria-labelledby="liability-title">
          <div class="flex items-center gap-sm mb-md">
            <span class="material-symbols-outlined text-primary">warning</span>
            <h2 id="liability-title" class="font-headline-lg text-headline-lg text-on-background uppercase text-xl">03. Limitación de Responsabilidad</h2>
          </div>
          <div class="space-y-md text-on-surface-variant leading-relaxed">
            <p>REDBOX no se hace responsable de los daños derivados del uso indebido de las herramientas de formación o servicios de consultoría técnica proporcionados.</p>
            <ul class="list-none space-y-sm font-mono text-[12px]">
              {RESPONSIBILITIES.map((item) => (
                <li class="flex items-start gap-sm">
                  <span class="text-primary mt-1" aria-hidden="true">▶</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Contact Grid -->
        <section class="col-span-12 tactical-border bg-primary/5 p-lg border-primary/40 scroll-reveal" aria-labelledby="contact-legal-title">
          <div class="grid md:grid-cols-4 gap-lg">
            <div class="col-span-2">
              <h3 id="contact-legal-title" class="font-headline-lg text-headline-lg text-primary mb-sm uppercase">Canales de Contacto Legal</h3>
              <p class="text-on-surface-variant">Todas las comunicaciones legales deben ser remitidas formalmente a nuestro departamento de cumplimiento normativo (DPO).</p>
            </div>
            <div class="flex flex-col justify-center">
              <p class="font-label-md text-primary uppercase text-[10px] font-bold tracking-widest">Email Corporativo</p>
              <p class="font-mono text-[12px] text-on-surface">legal@redbox.cyber</p>
            </div>
            <div class="flex flex-col justify-center">
              <p class="font-label-md text-primary uppercase text-[10px] font-bold tracking-widest">Atención Técnica</p>
              <p class="font-mono text-[12px] text-on-surface">+34 93 400 00 00</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes scan-legal {
    from { top: 0; }
    to { top: 100%; }
  }
  .scanline-legal {
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    height: 2px;
    position: fixed;
    pointer-events: none;
    animation: scan-legal 6s linear infinite;
    opacity: 0.3;
  }
  /* Tactical-border (aviso legal scoped variant) */
  .tactical-border {
    border: 1px solid rgba(255, 0, 0, 0.1);
    position: relative;
    background: rgba(18, 20, 24, 0.8);
    backdrop-filter: blur(4px);
  }
  .tactical-border::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 10px;
    height: 10px;
    border-top: 2px solid var(--color-primary);
    border-left: 2px solid var(--color-primary);
  }
  .tactical-border::after {
    content: '';
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 10px;
    height: 10px;
    border-bottom: 2px solid var(--color-primary);
    border-right: 2px solid var(--color-primary);
  }
</style>