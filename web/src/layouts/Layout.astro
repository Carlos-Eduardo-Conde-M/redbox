---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/sections.css';
import { SITE } from '../config/site';

export interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  lang = 'es',
  ogImage = SITE.defaultOgImage,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'es',
};
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts preconnect + Material Symbols CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
    />

    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-background text-on-background font-body antialiased">
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import { initScrollReveal } from '../animations/scroll-reveal';
      document.addEventListener('astro:page-load', initScrollReveal);
      initScrollReveal();
    </script>
  </body>
</html>