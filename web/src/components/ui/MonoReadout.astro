---
interface Props {
  label: string;
  value: string;
  class?: string;
}
const { label, value, class: className } = Astro.props;
---

<div class={['font-mono text-code-sm', className].filter(Boolean).join(' ')}>
  <span class="text-on-surface-variant">{label}: </span>
  <span class="text-primary">{value}</span>
</div>