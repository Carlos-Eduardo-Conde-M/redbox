---
interface Props {
  children: string;
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  as?: 'button' | 'a';
  href?: string;
  class?: string;
}

const { children, variant = 'primary', size = 'md', as = 'button', href, class: className } = Astro.props;

const base = [
  'font-label-md font-bold uppercase tracking-widest transition-all duration-300 cursor-pointer no-underline inline-flex items-center justify-center',
  size === 'sm' && 'px-4 py-2 text-label-sm',
  size === 'md' && 'px-6 py-2.5',
  size === 'lg' && 'px-8 py-4 text-[15px]',
  variant === 'primary' && 'bg-primary text-white shadow-[0_0_20px_rgba(230,0,0,0.4)] hover:brightness-110',
  variant === 'outline' && 'border border-primary text-primary hover:bg-primary/10',
  variant === 'ghost' && 'text-primary hover:bg-primary/10',
  'scale-95 active:scale-90',
  className,
].filter(Boolean).join(' ');
---

{
  as === 'a' && href ? (
    <a href={href} class={base}>{children}</a>
  ) : (
    <button type="button" class={base}>{children}</button>
  )
}