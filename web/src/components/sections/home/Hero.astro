---
/**
 * Home Hero — Sección 1.
 * Tagline "La mejor defensa es un ataque bien ejecutado" + logo tactical animado.
 */
---

<section
  class="relative min-h-[85vh] flex items-center overflow-hidden bg-surface-container-lowest"
  aria-labelledby="hero-headline"
>
  <div class="absolute inset-0 tactical-grid-fine opacity-20" aria-hidden="true"></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-primary/10 via-transparent to-background/80"
    aria-hidden="true"
  ></div>

  <div
    class="relative z-10 max-w-container-max mx-auto px-margin-desktop grid grid-cols-1 lg:grid-cols-2 gap-12 items-center scroll-reveal"
  >
    <div class="space-y-8">
      <div
        class="inline-flex items-center gap-3 px-4 py-1.5 bg-primary/5 border border-primary/40 animate-pulse"
      >
        <span class="font-label-sm text-primary uppercase tracking-[0.3em] font-bold">
          Protocol: Offensive_Mode // Active
        </span>
      </div>

      <h1
        id="hero-headline"
        class="font-headline-lg text-headline-lg text-on-background max-w-3x1 leading-tight uppercase tracking-tighter neon-glow "
      >
        La mejor defensa es un  <p></p>
        <span class="text-white bg-primary px-4 border-x-4 border-white/20">ataque</span> <p></p>
           bien ejecutado.
      </h1>

      <p
        class="font-body-lg text-on-surface-variant max-w-3x1 leading-relaxed uppercase tracking-wide"
      >
        [OPERACIONES_OFENSIVAS]: Ciberseguridad de élite para infraestructuras
        críticas. Neutralizamos amenazas replicando los ataques más sofisticados
        del mundo real.
      </p>

      <div class="flex flex-wrap gap-4 pt-4">
        <button
          class="bg-primary text-white px-8 py-4 font-label-md font-bold uppercase tracking-[0.2em] hover:shadow-[0_0_30px_#ff1a1a] transition-all border border-primary"
          type="button"
        >
          Contáctanos  
        </button>
        <div class="font-mono text-[10px] text-primary/60 flex flex-col justify-center">
          <div>SYS_STATUS: <span class="text-primary font-bold">NOMINAL</span></div>
          <div>SEC_LEVEL: <span class="text-primary font-bold">ALPHA_7</span></div>
        </div>
      </div>
    </div>

    <div class="hidden lg:block relative">
      <div class="aspect-square relative flex items-center justify-center p-8">
        <div
          class="absolute inset-0 border border-primary/20 animate-[spin_40s_linear_infinite]"
          aria-hidden="true"
        ></div>
        <div
          class="w-full h-full sharp-border overflow-hidden bg-black/40 backdrop-blur-sm flex items-center justify-center"
        >
          <div class="scanner-line"></div>
          <img
            alt="REDBOX Tactical Logo"
            class="w-4/5 h-auto object-contain tactical-logo-anim"
            src="/image/logo-redbox.png"
            width="800"
            height="800"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>