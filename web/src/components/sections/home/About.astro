---
/**
 * Home About / Quiénes Somos — Sección 2.
 * Manifiesto + 4 stats (10+ / 500+ / 24/7 / 100%).
 */
const STATS = [
  { value: '10+', label: 'Años de Operaciones' },
  { value: '500+', label: 'Intrusiones Exitosas' },
  { value: '24/7', label: 'Monitoreo Táctico' },
  { value: '100%', label: 'Compromiso' },
];
---

<section
  class="py-24 bg-surface border-y border-outline-variant/30 relative"
  id="nosotros"
  aria-labelledby="about-title"
>
  <div class="absolute inset-0 tactical-grid opacity-10 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-container-max mx-auto px-margin-desktop scroll-reveal">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="relative">
        <h2
          class="font-label-sm text-primary uppercase tracking-[0.4em] mb-4 font-bold border-l-4 border-primary pl-4"
        >
          Quiénes Somos
        </h2>
        <h3
          id="about-title"
          class="font-headline-md text-headline-md text-on-background mb-6 uppercase"
        >
          Expertos en Ciberseguridad Ofensiva
        </h3>
        <p class="font-body-lg text-on-surface-variant mb-6 leading-relaxed">
          Somos una firma de consultoría y entrenamiento avanzado especializada en
          ciberseguridad ofensiva. Nuestro equipo está compuesto por hackers éticos
          con experiencia en operaciones reales de Red Team.
        </p>
        <div class="bg-primary/5 border border-primary/20 p-6 font-mono text-sm text-primary/80">
          "En RedBox, no solo protegemos; comprendemos la mente del atacante para
          construir defensas infranqueables."
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {STATS.map((stat) => (
          <div class="bg-surface-container-high p-6 sharp-border">
            <div class="text-primary font-headline-lg mb-2">{stat.value}</div>
            <div class="font-label-sm uppercase tracking-widest text-on-surface-variant font-bold">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>