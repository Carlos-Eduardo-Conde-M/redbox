---
const CATEGORIES = [
  { label: 'Malware Analysis', count: '24' },
  { label: '0-Day Alerts', count: '09' },
  { label: 'Tactical Guides', count: '15' },
  { label: 'Lab Reports', count: '32' },
];

const INDICATORS = [
  { code: 'CVE-2024-9981', desc: 'Kernel Privilege Escalation — Linux v6.1', variant: 'primary' },
  { code: 'MALWARE_SIG_A4F', desc: 'New variant of DarkGate identified', variant: 'tertiary' },
];
---

<aside class="lg:col-span-4 space-y-8 scroll-reveal">
  <!-- Categorías -->
  <div class="sharp-border bg-surface-container-lowest/90 backdrop-blur-sm p-6 shadow-xl">
    <h4 class="font-label-md text-label-md font-bold text-primary mb-6 flex items-center gap-3 uppercase tracking-widest">
      <span class="material-symbols-outlined text-primary">category</span>
      CATEGORÍAS DE INTELIGENCIA
    </h4>
    <ul class="space-y-2">
      {CATEGORIES.map((cat) => (
        <li>
          <a class="flex justify-between items-center group p-3 hover:bg-primary/5 border-b border-outline-variant/10 transition-colors no-underline" href="#">
            <span class="text-on-surface group-hover:text-primary transition-colors font-label-md">{cat.label}</span>
            <span class="font-mono text-[10px] bg-primary/10 text-primary px-2 py-0.5">{cat.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Subscription -->
  <div class="sharp-border bg-primary/5 p-6 border-primary/30 shadow-xl">
    <h4 class="font-label-md text-label-md font-bold text-primary mb-4 flex items-center gap-3 uppercase tracking-widest">
      <span class="material-symbols-outlined">rss_feed</span>
      FEED DE INTELIGENCIA
    </h4>
    <p class="text-sm text-on-surface-variant mb-6 leading-relaxed">
      Alertas críticas directo a tu terminal. Sin ruido, solo data técnica.
    </p>
    <div class="space-y-4">
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-primary/50 text-sm">alternate_email</span>
        <input
          class="w-full bg-background/50 border border-outline-variant/30 focus:border-primary focus:ring-0 text-white font-mono pl-10 pr-3 py-3 text-xs"
          placeholder="OPERATOR@DOMAIN.COM"
          type="email"
          aria-label="Correo del operador"
        />
      </div>
      <button class="w-full bg-primary text-white py-4 font-bold uppercase text-xs tracking-widest hover:bg-primary/80 transition-all flex items-center justify-center gap-2 glitch-text-simple" type="button">
        UNIRSE AL CANAL
        <span class="material-symbols-outlined text-sm">sensors</span>
      </button>
    </div>
  </div>

  <!-- Radar widget -->
  <div class="h-48 sharp-border overflow-hidden relative grayscale hover:grayscale-0 transition-all duration-700 cursor-crosshair group">
    <div class="absolute inset-0 bg-primary/5 z-10" aria-hidden="true"></div>
    <div class="absolute inset-0 tactical-grid opacity-30" aria-hidden="true"></div>
    <div class="scanner-line"></div>
    <div class="w-full h-full bg-background flex flex-col items-center justify-center relative">
      <div class="relative">
        <div class="w-24 h-24 rounded-full border border-primary/30 animate-ping" aria-hidden="true"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="material-symbols-outlined text-4xl text-primary group-hover:scale-125 transition-transform">radar</span>
        </div>
      </div>
      <p class="font-mono text-[10px] text-primary mt-4 tracking-[0.2em] animate-pulse">THREAT_SCANNER_ACTIVE</p>
    </div>
  </div>
</aside>