---
const PILLARS = [
  {
    icon: 'folder_shared',
    id: 'FILE_SHARE_V2',
    status: 'NOMINAL',
    title: 'Recursos Compartidos',
    text: 'Acceso a una biblioteca curada de payloads, cheat-sheets de explotación y guías tácticas validadas por expertos en el campo.',
    items: ['Scripts Automatizados', 'Report Templates', 'POC Repositories'],
    prefix: 'DATA',
  },
  {
    icon: 'terminal',
    id: 'LAB_SYNC_PRO',
    status: 'ACTIVE',
    title: 'Retos Técnicos',
    text: 'Resolución colectiva de laboratorios complejos. Discutimos vectores de ataque, evasión de EDR y escalada de privilegios.',
    items: ['CTF Walkthroughs', 'Lab Debugging', 'Weekly Challenges'],
    prefix: 'OPS',
  },
  {
    icon: 'hub',
    id: 'NET_HUB_ELITE',
    status: 'SECURE',
    title: 'Networking Profesional',
    text: 'Conecta con líderes de la industria, encuentra oportunidades laborales exclusivas y forja alianzas estratégicas.',
    items: ['Job Board Direct', 'Mentor Matching', 'Partner Discounts'],
    prefix: 'HUB',
  },
];
---

<section class="py-24 px-margin-desktop max-w-container-max mx-auto relative" aria-labelledby="comunidad-pillars-title">
  <div class="text-center mb-16 scroll-reveal">
    <h3 class="font-label-sm text-primary uppercase tracking-[0.4em] mb-4 font-bold">CORE ECOSYSTEM</h3>
    <h2 id="comunidad-pillars-title" class="font-headline-md text-4xl text-white uppercase italic tracking-tight">Pilares de Colaboración</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 scroll-reveal">
    {PILLARS.map((pillar) => (
      <div class="bento-card p-8 group overflow-hidden">
        <div class="scanner-line"></div>
        <div class="flex justify-between items-start mb-6">
          <div class="w-14 h-14 bg-primary/10 border border-primary/30 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-3xl">{pillar.icon}</span>
          </div>
          <div class="text-right">
            <div class="text-[10px] font-mono text-primary font-bold">{pillar.id}</div>
            <div class="text-[9px] text-primary/40">STATUS: {pillar.status}</div>
          </div>
        </div>
        <h4 class="font-headline-sm text-xl text-white mb-4 uppercase">{pillar.title}</h4>
        <p class="font-body-md text-on-surface-variant mb-6 opacity-80 leading-relaxed">{pillar.text}</p>
        <ul class="space-y-3 font-label-md text-on-surface-variant font-mono text-[11px]">
          {pillar.items.map((item) => (
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-primary animate-pulse" aria-hidden="true"></span>
              [{pillar.prefix}] {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- Background Asset -->
  <div class="mt-20 sharp-border h-64 overflow-hidden relative scroll-reveal">
    <div class="scanner-line"></div>
    <img
      alt="Digital Vault Background"
      class="w-full h-full object-cover grayscale opacity-30 group-hover:opacity-60 transition-all duration-1000"
      src="/image/high_tech_cybersecurity_digital_map_showing_global_threat_connections_dark.png"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent" aria-hidden="true"></div>
    <div class="absolute bottom-6 left-8 font-mono text-[11px] text-primary bg-black/60 px-3 py-1 border border-primary/20">
      &gt;&gt; SEC_NODE: CENTRAL_HUB // DATA_STREAM: ENCRYPTED_LION_PROTOCOL
    </div>
  </div>
</section>