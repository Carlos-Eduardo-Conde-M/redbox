<section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden"
  style="background-image: url('/image/futuristic_industrial_circuit_board_background_with_glowing_red_neon_traces.png'); background-size: cover; background-position: center;"
  aria-labelledby="comunidad-hero-title"
>
  <div class="absolute inset-0 bg-background/80 backdrop-blur-sm" aria-hidden="true"></div>
  <div class="absolute inset-0 tactical-grid opacity-20" aria-hidden="true"></div>
  <div class="relative z-10 text-center px-margin-mobile md:px-margin-desktop max-w-4xl mx-auto scroll-reveal">
    <div class="inline-flex items-center gap-3 px-4 py-1.5 bg-primary/5 border border-primary/40 mb-8 animate-pulse">
      <span class="font-label-sm text-primary uppercase tracking-[0.3em] font-bold">Protocol: Offensive_Community // Active</span>
    </div>
    <h1 id="comunidad-hero-title" class="font-headline-lg text-[48px] md:text-[64px] mb-6 leading-none text-white uppercase tracking-tighter neon-glow">
      Comunidad <span class="text-primary bg-white/5 px-4 border-x-4 border-primary">RedBox</span>
    </h1>
    <p class="font-body-lg text-xl text-on-surface-variant max-w-2xl mx-auto mb-10 uppercase tracking-widest font-light">
      Un ecosistema exclusivo para profesionales de seguridad ofensiva.
    </p>
    <div class="flex flex-wrap justify-center gap-6">
      <a class="bg-primary text-white flex items-center gap-4 px-10 py-5 font-label-md font-bold uppercase tracking-[0.2em] shadow-[0_0_30px_#ff1a1a] transition-all hover:scale-105 active:scale-95 border border-primary" href="#join">
        <span class="material-symbols-outlined">forum</span>
        Unirse al Canal y Grupo de WhatsApp
      </a>
    </div>
    <div class="mt-12 flex justify-center gap-8 font-mono text-[10px] text-primary/60">
      <div>SYS_STATUS: <span class="text-primary font-bold">NOMINAL</span></div>
      <div>SEC_LEVEL: <span class="text-primary font-bold">ALPHA_7</span></div>
      <div>OPS_READY: <span class="text-primary font-bold">TRUE</span></div>
    </div>
  </div>
</section>