---
/**
 * Servicios CTA — Sección 3.
 * Glitch headline + dos botones (cotización técnica + hablar con Red Team) + status bar.
 */
---

<section
  class="py-24 bg-surface-container-lowest relative border-y border-primary/20 overflow-hidden"
  aria-labelledby="servicios-cta-title"
>
  <div class="absolute inset-0 tactical-grid opacity-10" aria-hidden="true"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-margin-mobile text-center scroll-reveal">
    <h2
      id="servicios-cta-title"
      class="font-headline-md text-headline-md mb-10 uppercase tracking-[-0.05em] font-black glitch-text-simple"
      data-text="¿LISTO PARA BLINDAR SU PERÍMETRO?"
    >
      ¿LISTO PARA BLINDAR SU PERÍMETRO?
    </h2>

    <div class="flex flex-col md:flex-row gap-6 justify-center items-stretch">
      <a
        class="bg-primary-container text-white px-10 py-5 font-label-md font-extrabold hover:shadow-[0_0_30px_#ff1a1a] transition-all flex items-center justify-center gap-4 group uppercase tracking-[0.2em] border border-primary"
        href="#"
      >
        SOLICITAR_COTIZACIÓN_TÉCNICA
        <span class="material-symbols-outlined group-hover:translate-x-2 transition-transform">terminal</span>
      </a>
      
    </div>

    <div class="mt-12 flex justify-center items-center gap-4 font-mono text-[10px] text-primary opacity-60">
      <span class="animate-pulse text-lg" aria-hidden="true">●</span>
      <span class="tracking-[0.4em] font-bold">OPERACIONES ACTIVAS 24/7/365 // PRIORIDAD: CRÍTICA</span>
      <span class="animate-pulse text-lg" aria-hidden="true">●</span>
    </div>
  </div>
</section>