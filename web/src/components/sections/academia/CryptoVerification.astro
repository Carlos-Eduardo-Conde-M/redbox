---
---

<section class="py-24 bg-background relative overflow-hidden border-y border-primary/20" aria-labelledby="crypto-title">
  <div class="absolute inset-0 scanner-line opacity-10" style="animation-duration: 8s" aria-hidden="true"></div>
  <div class="container mx-auto px-margin-desktop scroll-reveal">
    <div class="mb-16 scroll-reveal">
    <h2 id="academia-pillars-title" class="font-display-lg text-headline-lg text-white uppercase tracking-tighter mb-4">
      VERIFICACIÓN DE <span class="text-primary">CERTIFICADOS</span>
    </h2>
    <div class="h-1 w-24 bg-primary"></div>
  </div>
    <div class="max-w-4xl mx-auto sharp-border bg-black/60 p-2 lg:p-4" style="transition-delay: 0.6s;">
      <div class="bg-surface-container p-8 lg:p-12 relative overflow-hidden">
        <div class="absolute inset-0 tactical-grid opacity-5" aria-hidden="true"></div>
        <div class="flex items-center gap-2 mb-10 border-b border-primary/20 pb-4 relative z-10">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-primary animate-pulse"></div>
            <div class="w-3 h-3 rounded-full bg-primary/40"></div>
            <div class="w-3 h-3 rounded-full bg-primary/20"></div>
          </div>
          <div class="mx-auto font-code-sm text-[10px] text-primary/60 tracking-[0.6em] uppercase">
            CRYPTO_VERIFICATION_PROTOCOL_v4.2
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-12 items-center relative z-10">
          <div class="space-y-8">
            <div>
              <h2 id="crypto-title" class="font-display-lg text-headline-md text-white uppercase mb-2 tracking-tighter">
                VALIDACIÓN POR<span class="text-primary"> CÓDIGO</span>
              </h2>
              <div class="h-0.5 w-12 bg-primary"></div>
            </div>
            <div class="font-mono text-[11px] space-y-4">
              <div class="flex items-center gap-3 text-primary/80">
                <span class="material-symbols-outlined text-sm">shield_lock</span>
                <p>ESTADO: PROTOCOLO DE AUTENTECIDAD ACTIVO</p>
              </div>
              <div class="flex items-center gap-3 text-primary/80">
                <span class="material-symbols-outlined text-sm">fingerprint</span>
                <p>VERIFICACIÓN: FIRMA DIGITAL SHA-256</p>
              </div>
              <p class="text-on-surface-variant/60 pl-7 leading-relaxed uppercase">
                INGRESE EL HASH DE IDENTIFICACIÓN ÚNICO PARA VALIDAR LA INTEGRIDAD DE LA FORMACIÓN.
              </p>
            </div>
            <div class="space-y-4">
              <div class="relative group">
                <div class="absolute -inset-0.5 bg-primary/20 blur opacity-0 group-focus-within:opacity-100 transition duration-500"></div>
                <input
                  class="relative w-full bg-black/40 border border-primary/30 p-5 font-code-sm text-sm text-primary placeholder:text-primary/20 focus:outline-none focus:border-primary transition-all uppercase tracking-widest"
                  placeholder="HASH_ID: RBX-XXXX-XXXX"
                  type="text"
                  aria-label="Hash de verificación criptográfica"
                />
                <div class="absolute right-5 top-1/2 -translate-y-1/2 flex gap-1">
                  <span class="w-1.5 h-1.5 bg-primary animate-pulse" aria-hidden="true"></span>
                </div>
              </div>
              <button class="w-full bg-primary text-white py-5 font-label-md text-label-md font-black uppercase tracking-[0.5em] hover:brightness-110 active:scale-[0.98] transition-all shadow-[0_0_30px_rgba(255,0,0,0.2)] flex items-center justify-center gap-3" type="button">
                EJECUTAR VALIDACIÓN <span class="material-symbols-outlined">key</span>
              </button>
            </div>
          </div>
          <div class="hidden md:flex flex-col items-center justify-center border-l border-primary/10 pl-12 h-full">
            <div class="relative">
              <div class="absolute inset-0 bg-primary/10 blur-3xl rounded-full animate-pulse" aria-hidden="true"></div>
              <span class="material-symbols-outlined text-[140px] text-primary/30 relative z-10" style="font-variation-settings: 'FILL' 1;">verified_user</span>
            </div>
            <div class="mt-8 space-y-2 text-center">
              <p class="font-code-sm text-[10px] text-primary uppercase tracking-[0.3em]">SISTEMA ANTI-FRAUDE</p>
              <p class="font-code-sm text-[10px] text-on-surface-variant/40 uppercase tracking-widest">[NODE_STATUS: SECURE_CONNECTED]</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>