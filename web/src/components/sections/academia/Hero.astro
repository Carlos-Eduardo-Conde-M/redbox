---
---

<section class="relative min-h-[70vh] pt-32 pb-20 flex items-center overflow-hidden"
  style="background-image: url('/image/futuristic_industrial_circuit_board_background_with_glowing_red_neon_traces.png'); background-size: cover; background-position: center;"
  aria-labelledby="academia-hero-title"
>
  <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-background/90 z-1" aria-hidden="true"></div>

  <div class="container mx-auto px-margin-desktop relative z-10 grid lg:grid-cols-2 gap-12 items-center scroll-reveal">
    <div class="space-y-8">
      <div class="inline-flex items-center gap-3 px-4 py-1.5 bg-primary/5 border border-primary/40 animate-pulse">
        <span class="font-label-sm text-primary uppercase tracking-[0.3em] font-bold">[PROTOCOL: ACADEMIC_OPS // ACTIVE]</span>
      </div>
      <h1 id="academia-hero-title" class="font-display-lg text-display-lg text-on-background leading-tight uppercase tracking-tighter neon-glow">
        FORJAMOS <br /><span class="text-white bg-primary px-4 border-x-4 border-white/20">EL ESCUDO DIGITAL</span>
      </h1>
      <p class="font-body-lg text-on-surface-variant max-w-3xl leading-relaxed uppercase tracking-wide">
        No es solo teoría; es supervivencia. Nuestros programas de entrenamiento están diseñados para operar en los entornos más hostiles del ciberespacio, transformando profesionales en arquitectos de defensa inquebrantable.
      </p>
      <div class="flex flex-wrap gap-4 pt-4">
        <button class="bg-primary text-white px-8 py-4 font-label-md font-bold uppercase tracking-[0.2em] hover:shadow-[0_0_30px_#ff0000] transition-all border border-primary flex items-center gap-3" type="button">
          HABLAR CON NUESTRO EQUIPO 
          <span class="material-symbols-outlined" aria-hidden="true">headset_mic</span>
        </button>
      </div>
    </div>
    <div class="relative group">
      <div class="sharp-border overflow-hidden aspect-video shadow-2xl shadow-primary/20 bg-black/40 backdrop-blur-sm">
        <div class="scanner-line"></div>
        <img
          alt="Terminal Interface Operation"
          class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110 grayscale brightness-50"
          src="/image/academia-aspect-video-1.png"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>