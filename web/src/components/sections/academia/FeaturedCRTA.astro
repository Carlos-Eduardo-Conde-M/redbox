---
---

<div class="lg:col-span-12 scroll-reveal">
  <div class="mb-16 scroll-reveal">
    <h2 id="academia-pillars-title" class="font-display-lg text-headline-lg text-white uppercase tracking-tighter mb-4">
     <span class="text-primary">CURSOS</span>
    </h2>
    <div class="h-1 w-24 bg-primary"></div>
  </div>
  <div class="sharp-border bg-gradient-to-br from-surface-container-high to-background border-primary/40 py-0 lg:p-12 cyber-card-glow group relative overflow-hidden" style="transition-delay: 0.2s;">
    <div class="scanner-line opacity-30"></div>
    <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity">
      <span class="material-symbols-outlined text-[120px] text-primary">military_tech</span>
    </div>
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="relative">
        <div class="absolute -inset-4 bg-primary/20 blur-3xl rounded-full opacity-50 group-hover:opacity-80 transition-opacity"></div>
        <img
          alt="CRTA Certification"
          class="relative z-10 w-full shadow-2xl border border-primary/30 grayscale hover:grayscale-0 transition-all duration-700"
          src="/image/academia-CRTA.png"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary text-white font-label-md text-xs font-black uppercase tracking-widest">
          <span class="material-symbols-outlined text-sm">verified</span> OFFICIAL PARTNERSHIP
        </div>
        <h3 class="font-headline-lg text-4xl md:text-5xl text-white uppercase leading-none font-black">CRTA: CERTIFIED RED TEAM ANALYST</h3>
        <p class="text-on-surface-variant font-body-md uppercase tracking-wide border-l-2 border-primary/40 pl-4">
          Colaboración oficial con Cyberwarfare Labs para formación de élite en operaciones ofensivas.
        </p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-y-3 gap-x-6">
          <li class="flex items-center gap-3 font-label-md text-on-surface text-sm"><span class="w-1.5 h-1.5 bg-primary"></span> ENUMERACIÓN Y EXPLOTACIÓN</li>
          <li class="flex items-center gap-3 font-label-md text-on-surface text-sm"><span class="w-1.5 h-1.5 bg-primary"></span> ATAQUES AD EN ENTORNOS REALES</li>
          <li class="flex items-center gap-3 font-label-md text-on-surface text-sm"><span class="w-1.5 h-1.5 bg-primary"></span> MOVIMIENTO LATERAL</li>
          <li class="flex items-center gap-3 font-label-md text-on-surface text-sm"><span class="w-1.5 h-1.5 bg-primary"></span> ESCALADA DE PRIVILEGIOS</li>
        </ul>
        <div class="pt-4 flex flex-wrap gap-4">
          <div class="bg-surface-container p-4 border border-outline-variant/30 flex-1 min-w-[200px]">
            <p class="font-code-sm text-[10px] text-primary mb-1 uppercase tracking-tighter">[INCLUDES]</p>
            <p class="text-xs font-bold uppercase">30 Días de Labs en la Nube + Examen Oficial</p>
          </div>
          <div class="bg-primary/10 p-4 border border-primary/30 flex-1 min-w-[200px]">
            <p class="font-code-sm text-[10px] text-primary mb-1 uppercase tracking-tighter">[CREDENTIALS]</p>
            <p class="text-xs font-bold uppercase">Doble Certificación (CWL + REDBOX)</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>