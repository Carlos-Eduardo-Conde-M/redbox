---
---

<section
  class="relative h-[85vh] min-h-[600px] flex items-center overflow-hidden border-b border-primary/20 pt-20"
  aria-labelledby="qs-hero-title"
>
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-background/60 z-10" aria-hidden="true"></div>
    <img
      alt="Centro de operaciones tácticas"
      class="w-full h-full object-cover grayscale brightness-50"
      src="/image/futuristic_industrial_circuit_board_background_with_glowing_red_neon_traces.png"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 tactical-grid z-20" aria-hidden="true"></div>
    <div class="scanner-line" aria-hidden="true"></div>
  </div>

  <div class="relative z-30 px-margin-mobile md:px-margin-desktop w-full max-w-[1400px] mx-auto scroll-reveal">
    <div class="max-w-4xl space-y-8">
      <div class="flex items-center gap-4">
        <span class="w-16 h-[3px] bg-primary box-glow-strong" aria-hidden="true"></span>
        <span class="font-mono text-primary uppercase tracking-[0.3em] font-bold text-[12px]">
          Estado: Operativo // Misión Activa
        </span>
      </div>
      <h1
        id="qs-hero-title"
        class="font-headline-lg text-display-lg text-on-surface uppercase leading-none tracking-tight"
      >
        Nuestra <span class="text-primary neon-glow">Misión</span>
      </h1>
      <div class="border-l-[6px] border-primary pl-8 py-4 bg-primary/5 backdrop-blur-sm">
        <p class="font-headline-sm text-xl md:text-2xl text-on-surface leading-relaxed max-w-2xl">
          Neutralizamos las amenazas más avanzadas del espectro digital. Protegemos infraestructuras
          críticas con precisión táctica y defensa absoluta. No solo monitoreamos; dominamos el entorno.
        </p>
      </div>
      
    </div>
  </div>

  <!-- Coordinates deco -->
  <div class="absolute right-margin-desktop bottom-20 z-30 hidden lg:block text-right font-mono text-[12px] scroll-reveal">
    <div class="space-y-1">
      <p class="text-primary uppercase tracking-widest opacity-70">Ubicación Actual</p>
      <p class="text-on-surface text-lg font-bold">CENTRO DE OPERACIONES TÁCTICAS (TOC)</p>
      <p class="text-primary font-bold">LAT: 19.4326 | LONG: -99.1332</p>
      <div class="h-[2px] w-full bg-primary/30 mt-2" aria-hidden="true"></div>
    </div>
  </div>
</section>