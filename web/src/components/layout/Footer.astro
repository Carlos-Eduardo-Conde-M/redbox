---
import { LEGAL_LINKS, SOCIAL_LINKS, FOOTER_COLUMNS } from '../../constants/nav';
import { COMPANY } from '../../constants/company';
import { SITE } from '../../config/site';
---

<footer class="bg-surface-dim border-t border-outline-variant/30 w-full pt-20 pb-10 relative">
  <div class="absolute inset-0 tactical-grid-fine opacity-5" aria-hidden="true"></div>
  <div class="max-w-container-max mx-auto px-margin-desktop scroll-reveal visible">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Column 1: Brand Info -->
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <img
            alt="REDBOX Logo"
            class="h-10 w-auto"
            src="/image/logo-redbox.png"
            width="40"
            height="40"
            loading="lazy"
          />
          <span class="font-headline-md text-headline-md font-black tracking-tighter text-primary">REDBOX</span>
        </div>
        <p class="text-on-surface-variant font-body-md leading-relaxed">
          Defensa ofensiva y formación de élite. Neutralizamos adversarios antes de que comprometan su activo más valioso.
        </p>
<nav aria-label="Redes sociales">
          <div class="flex flex-wrap gap-3">
            {SOCIAL_LINKS.map((link) => (
              <a
                class="w-10 h-10 flex items-center justify-center bg-surface-container-high border border-outline/10 opacity-70 hover:opacity-100 hover:border-primary/50 transition-all"
                href={link.href}
                aria-label={link.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="material-symbols-outlined text-on-surface-variant text-[22px]" aria-hidden="true">{link.icon}</span>
              </a>
            ))}
          </div>
        </nav>
      </div>

      <!-- Columns: Servicios / Recursos -->
      {FOOTER_COLUMNS.map((column) => (
        <div>
          <h4 class="font-label-md text-primary uppercase tracking-[0.2em] mb-8 font-bold">{column.title}</h4>
          <ul class="space-y-4">
            {column.links.map((link) => (
              <li>
                <a
                  class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Column 4: Contacto -->
      <div>
        <h4 class="font-label-md text-primary uppercase tracking-[0.2em] mb-8 font-bold">Contacto</h4>
        <ul class="space-y-6">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary mt-1" aria-hidden="true">mail</span>
            <span class="text-on-surface-variant font-body-md">{COMPANY.email}</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary mt-1" aria-hidden="true">call</span>
            <span class="text-on-surface-variant font-body-md">{COMPANY.phone}</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary mt-1" aria-hidden="true">location_on</span>
            <span class="text-on-surface-variant font-body-md">
              {COMPANY.addressLines.map((line) => (
                <>{line}<br /></>
              ))}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="border-t border-outline-variant/20 pt-10 flex flex-col lg:flex-row justify-between items-center gap-6">
      <div class="text-on-surface-variant/60 font-label-sm uppercase tracking-widest text-center lg:text-left">
        &copy; {new Date().getFullYear()} {SITE.title}. TODOS LOS DERECHOS RESERVADOS.
      </div>
      <nav aria-label="Navegación legal" class="flex flex-wrap justify-center gap-8">
        {LEGAL_LINKS.map((link) => (
          <a
            class="font-label-sm text-on-surface-variant/80 hover:text-primary transition-colors uppercase tracking-widest"
            href={link.href}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>