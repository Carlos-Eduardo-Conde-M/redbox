---
import { NAV_LINKS } from '../../constants/nav';

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 w-full z-50 bg-background/90 backdrop-blur-xl border-b border-primary/20 shadow-[0_0_15px_rgba(230,0,0,0.15)]"
  role="banner"
>
  <div class="flex justify-between items-center h-20 px-margin-desktop max-w-container-max mx-auto">
    <!-- Logo + Wordmark -->
    <a href="/" class="flex items-center gap-3 no-underline" aria-label="RedBox — Ir al inicio">
      <img
        alt="REDBOX Logo"
        class="h-10 w-auto"
        src="/image/logo-redbox.png"
        width="40"
        height="40"
        loading="eager"
        decoding="auto"
      />
      <span class="font-headline-md text-headline-md font-black tracking-tighter text-primary">REDBOX</span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Navegación principal" class="hidden md:flex gap-8 items-center">
      {NAV_LINKS.map((link) => {
        const isActive =
          link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={[
              'font-label-md transition-colors duration-300',
              isActive
                ? 'text-primary border-b-2 border-primary pb-1'
                : 'text-on-surface-variant hover:text-primary',
            ].join(' ')}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-4">
      <button
        class="bg-primary text-white px-6 py-2.5 font-label-md font-bold uppercase tracking-widest cursor-pointer scale-95 active:scale-90 transition-transform shadow-[0_0_20px_rgba(230,0,0,0.4)]"
        type="button"
      >
        CONTÁCTANOS
      </button>
    </div>

    <!-- Mobile menu trigger -->
    <button
      class="md:hidden flex items-center justify-center w-10 h-10 text-on-surface-variant hover:text-primary transition-colors"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-toggle
    >
      <span class="material-symbols-outlined text-[24px]" data-mobile-icon>menu</span>
    </button>
  </div>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute top-full left-0 right-0 bg-surface-dim/95 backdrop-blur-xl border-b border-primary/20 shadow-[0_0_15px_rgba(230,0,0,0.2)]"
    aria-label="Menú móvil"
    role="dialog"
    aria-modal="true"
    data-mobile-overlay
  >
    <nav class="flex flex-col px-margin-desktop py-6 space-y-4">
      {NAV_LINKS.map((link) => {
        const isActive =
          link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={[
              'font-label-md text-[16px] py-3 transition-colors',
              isActive ? 'text-primary' : 'text-on-surface-variant hover:text-primary',
            ].join(' ')}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
    <div class="px-margin-desktop pb-6">
      <button
        class="w-full bg-primary text-white px-6 py-3 font-label-md font-bold uppercase tracking-widest cursor-pointer shadow-[0_0_20px_rgba(230,0,0,0.4)]"
        type="button"
      >
        CONTÁCTANOS
      </button>
    </div>
  </div>
</header>

<script>
  (function () {
    const toggle = document.querySelector('[data-mobile-toggle]') as HTMLElement | null;
    const overlay = document.querySelector('[data-mobile-overlay]') as HTMLElement | null;
    const icon = document.querySelector('[data-mobile-icon]') as HTMLElement | null;
    if (!toggle || !overlay || !icon) return;

    const open = function (this: unknown) {
      overlay.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú de navegación');
      icon.textContent = 'close';
      document.body.style.overflow = 'hidden';
    };

    const close = function (this: unknown) {
      overlay.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      icon.textContent = 'menu';
      document.body.style.overflow = '';
    };

    toggle.addEventListener('click', function (this: HTMLElement) {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      expanded ? close() : open();
    });

    overlay.addEventListener('click', function (this: HTMLElement, e: MouseEvent) {
      if (e.target === overlay) close();
    });

    document.addEventListener('keydown', function (this: Document, e: KeyboardEvent) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });

    document.addEventListener('astro:before-swap', close);
  })();
</script>